
pipeline {
    agent any

    tools {
        maven 'mvn'
    }

    stages {
        stage('Build') {
            steps {
                dir('electricity-bill') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('electricity-bill') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('electricity-bill') {
                    bat 'mvn package'
                }
            }
        }
    }
}
